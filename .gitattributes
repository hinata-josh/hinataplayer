# 讓 .bat 永遠是 CRLF（LF 會讓 cmd 解析錯亂、變數不展開）
*.bat text eol=crlf
*.cmd text eol=crlf

# macOS 啟動器一定要 LF，CRLF 會讓 bash 直接壞掉
*.command text eol=lf
*.sh      text eol=lf

# 其餘文字檔一律 LF
*.html text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# 二進位別動
*.mp3 binary
*.wav binary
*.m4a binary
*.flac binary
*.png binary
